{
  "name": "@lorenzbus/intacct-rest",
  "version": "0.1.0-beta.1",
  "description": "Typed, host-agnostic TypeScript client for the Sage Intacct REST API, generated from Sage's OpenAPI specification.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./windmill": {
      "import": {
        "types": "./dist/esm/windmill/index.d.ts",
        "default": "./dist/esm/windmill/index.js"
      },
      "require": {
        "types": "./dist/cjs/windmill/index.d.ts",
        "default": "./dist/cjs/windmill/index.js"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/esm/generated/*/index.d.ts",
        "default": "./dist/esm/generated/*/index.js"
      },
      "require": {
        "types": "./dist/cjs/generated/*/index.d.ts",
        "default": "./dist/cjs/generated/*/index.js"
      }
    }
  },
  "scripts": {
    "spec:fetch": "node scripts/fetch-spec.ts",
    "generate": "node scripts/generate.ts",
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "token:test": "node --env-file=.env examples/get-token.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "windmill-client": "^1.813.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lorenz-bus-service/node-intacct-rest-api.git"
  },
  "keywords": [
    "intacct",
    "sage",
    "sage-intacct",
    "rest",
    "api",
    "client",
    "typescript",
    "openapi",
    "windmill"
  ],
  "peerDependencies": {
    "windmill-client": ">=1"
  },
  "peerDependenciesMeta": {
    "windmill-client": {
      "optional": true
    }
  }
}
